	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"@types/node": "^26.1.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"typescript": "^6.0.3"
	}
