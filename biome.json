{
	"$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
	"javascript": {
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"files": {
		"includes": [
			"**",

			"!**/globals.css",

			"!packages/ui/src/components",
			"!packages/ui/src/lib",
			"!packages/ui/src/hooks",

			"!**/.next",
			"!**/node_modules",
			"!**/generated",
			"!**/dist",
			"!**/build",
			"!**/out",
			"!**/turbo",
			"!**/.turbo",

			"!**/openapi.json"
		]
	}
}
