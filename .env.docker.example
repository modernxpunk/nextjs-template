NODE_ENV=production

# PostgreSQL runs as the `postgres` service inside Docker network.
DATABASE_URL=postgresql://modernpunk:password@postgres:5432/app

# Public API address (used by API service for auth baseURL).
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
LOKI_URL=http://loki:3100
LOKI_APP_NAME=api

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# S3/RustFS configuration
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password123
S3_BUCKET=uploads
S3_PUBLIC_URL=http://localhost:9000

# Required only when sending password-reset emails.
RESEND_TOKEN=
RESEND_FROM=Example App <no-reply@example.com>
