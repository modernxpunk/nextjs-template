NODE_ENV=production

# PostgreSQL runs as the `postgres` service inside Docker network.
DATABASE_URL=postgresql://modernpunk:password@postgres:5432/app

# Public API address (used by API service for auth baseURL).
API_URL=http://localhost:4000
PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-long-random-secret

# Required by web server env schema.
EMAIL_USER=example@gmail.com
EMAIL_PASS=app-password
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret

# Optional for @repo/email package.
RESEND_TOKEN=
