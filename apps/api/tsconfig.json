{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "@repo/typescript-config/nestjs.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"sourceMap": true,
		"declaration": false,
		"noEmit": true,
		"allowImportingTsExtensions": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
