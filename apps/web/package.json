{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "node ./scripts/with-api-ready.mjs next dev -p 3000 --turbopack",
		"dev:types": "kubb --watch --config ./kubb.config.ts",
		"generate:api": "kubb --config ./kubb.config.ts",
		"build": "pnpm generate:api && next build",
		"start": "node ./scripts/with-api-ready.mjs next start",
		"export": "next export",
		"check-types": "next typegen && pnpm generate:api && tsc --noEmit"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.4.0",
		"@repo/ui": "workspace:*",
		"@t3-oss/env-core": "^0.13.11",
		"@tanstack/react-query": "^5.101.2",
		"better-auth": "^1.6.23",
		"clsx": "^2.1.1",
		"jiti": "^2.7.0",
		"lucide-react": "^1.23.0",
		"negotiator": "^1.0.0",
		"next": "^16.2.10",
		"next-intl": "^4.13.1",
		"next-themes": "^0.4.6",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-hook-form": "^7.80.0",
		"sharp": "^0.35.3",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"viem": "~2.55.4",
		"wagmi": "^3.6.21",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@kubb/cli": "^4.39.2",
		"@kubb/core": "^4.39.2",
		"@kubb/plugin-oas": "^4.39.2",
		"@kubb/plugin-ts": "^4.39.2",
		"@repo/typescript-config": "workspace:*",
		"@types/negotiator": "^0.6.4",
		"@types/node": "^26.1.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"prettier": "^3.8.1"
	}
}
