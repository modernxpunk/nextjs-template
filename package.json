{
	"name": "nextjs-template",
	"version": "1.0.0",
	"packageManager": "pnpm@10.16.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/modernxpunk/nextjs-template.git"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"lint": "biome check . --error-on-warnings",
		"lint:staged": "biome check --staged --error-on-warnings --no-errors-on-unmatched",
		"format": "biome check . --write",
		"start": "turbo run start --filter=web",
		"db:deploy": "pnpm --filter @repo/db db:deploy",
		"migrate": "pnpm --filter @repo/db db:migrate",
		"prepare": "husky"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/modernxpunk/nextjs-template/issues"
	},
	"homepage": "https://github.com/modernxpunk/nextjs-template#readme",
	"description": "",
	"dependencies": {
		"turbo": "^2.5.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"husky": "^9.1.7",
		"typescript": "^5.9.2"
	}
}
