{
	"name": "nextjs-template",
	"version": "1.0.0",
	"packageManager": "pnpm@10.16.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/modernxpunk/nextjs-template.git"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"lint": "biome check . --error-on-warnings",
		"lint:staged": "biome check --staged --error-on-warnings --no-errors-on-unmatched",
		"format": "biome check . --write",
		"start": "turbo run start --filter=api --filter=web",
		"docker:bootstrap": "docker compose up -d postgres loki grafana && docker compose build migrate && docker compose run --rm migrate && docker compose up --build -d api web",
		"docker:up": "docker compose up --build -d postgres loki grafana api web",
		"docker:migrate": "docker compose build migrate && docker compose run --rm migrate",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f web api postgres loki grafana",
		"db:deploy": "pnpm --filter @repo/db db:deploy",
		"migrate": "pnpm --filter @repo/db db:migrate",
		"prepare": "husky"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/modernxpunk/nextjs-template/issues"
	},
	"homepage": "https://github.com/modernxpunk/nextjs-template#readme",
	"description": "",
	"dependencies": {
		"turbo": "^2.8.14"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.6",
		"@commitlint/cli": "^20.4.3",
		"@commitlint/config-conventional": "^20.4.3",
		"husky": "^9.1.7",
		"typescript": "^5.9.3"
	}
}
