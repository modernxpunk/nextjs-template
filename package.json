{
	"name": "nextjs-template",
	"version": "1.0.0",
	"packageManager": "npm@8.5.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/modernxpunk/nextjs-template.git"
	},
	"prisma": {
		"schema": "packages/database/prisma/schema.prisma"
	},
	"scripts": {
		"format-and-lint": "biome check .",
		"format-and-lint:fix": "biome check . --write",
		"db:migrate:deploy": "turbo run db:migrate:deploy",
		"db:push": "turbo run db:push",
		"generate": "turbo run generate",
		"prepare": "husky"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/modernxpunk/nextjs-template/issues"
	},
	"homepage": "https://github.com/modernxpunk/nextjs-template#readme",
	"description": "",
	"dependencies": {
		"@prisma/client": "^6.14.0",
		"turbo": "^2.5.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"husky": "^9.1.7",
		"typescript": "^5.9.2"
	}
}
